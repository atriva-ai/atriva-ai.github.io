---
import { Icon } from "astro-icon/components";
---

<section class="py-16 bg-gradient-to-r from-slate-50 to-slate-100">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-slate-800 sm:text-4xl">
      Tell us what you need to detect.
    </h2>
    <p class="mt-4 text-lg text-slate-600">
      We'll tell you what fits and what it takes to deploy it.
    </p>
    <div class="mt-8 flex justify-center">
      <a
        href="/contact"
        class="flex gap-2 items-center justify-center bg-[#48A18D] text-white font-semibold px-8 py-4 rounded-lg hover:bg-[#3b8675] transition"
      >
        <Icon class="w-5 h-5 text-white" name="bx:bx-message-rounded-dots" />
        Talk to Us
      </a>
    </div>
  </div>
</section>
