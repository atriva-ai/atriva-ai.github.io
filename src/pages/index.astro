---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Cta from "@/components/cta.astro";
import Hero from "@/components/hero.astro";
import AgenticAI from "@/components/AgenticAI.astro";
import UseCases from "@/components/UseCases.astro";
import WhoWeHelp from "@/components/WhoWeHelp.astro";
---

<Layout title="Edge AI Deployment Partner">
  <section class="relative overflow-hidden py-24">
    <div class="absolute inset-0 bg-gradient-to-tl from-[#48A18D]/15 via-[#48A18D]/5 to-transparent"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[#48A18D]/10 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight text-slate-900">Edge AI Solutions, Delivered.</h1>
      <p class="mt-6 text-lg md:text-xl text-slate-600">Production-ready edge AI video solutions — running on-site, on cameras you already have. We've built them, and we know how to deploy them.</p>
    </div>
  </section>

  <Container>
    <Hero />
    <WhoWeHelp />
    <UseCases />
    <AgenticAI />
    <Cta />
  </Container>
</Layout>
