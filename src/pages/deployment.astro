---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

const specs = [
  { label: "Runs on",           value: "NVIDIA Jetson, Intel, Rockchip, Hailo, MemryX" },
  { label: "Cameras",           value: "Any RTSP/ONVIF IP camera — existing cameras are fine" },
  { label: "Network",           value: "Local processing. No cloud dependency, no video leaves the site" },
  { label: "On-site footprint", value: "One edge device per 8–16 cameras" },
  { label: "Output",            value: "Structured JSON events to your systems, or our dashboard" },
  { label: "Time to stand up",  value: "1–3 days per site once hardware is on-site" },
];

const faqs = [
  {
    q: "Can it use our existing cameras and VMS?",
    a: "Yes. Atriva works with any IP camera that streams over RTSP or ONVIF, which covers the majority of cameras installed in the last decade. We don't replace your VMS — we sit alongside it, reading the same stream your VMS already records. You keep your existing footage, access control, and recording workflows unchanged.",
  },
  {
    q: "What happens if the network drops?",
    a: "The edge device keeps processing. Detection, alerting, and local logging all continue without a cloud connection — there's nothing cloud-side that the on-device runtime depends on. Events queue locally and sync when connectivity is restored. The only thing that goes offline is remote access to the dashboard.",
  },
  {
    q: "Who installs it — you or us?",
    a: "Either, depending on what makes sense for your site. For first deployments we typically install ourselves so we can calibrate detection zones and validate performance on-site before handover. For subsequent sites we can train your team or a local integrator to handle it. The containers are designed to be reproducible — the same config that worked on site one works on site ten.",
  },
  {
    q: "Can we run it on hardware we already own?",
    a: "Possibly. If you have an x86 server or an NVIDIA Jetson on-site, we can often deploy to it. We'll tell you upfront if the hardware won't meet the throughput requirements for your camera count rather than letting you find out after install. We'd rather right-size the hardware at the start than debug performance issues later.",
  },
  {
    q: "What does ongoing support cost?",
    a: "Support is scoped per deployment and quoted before you sign — not hidden in a per-camera annual fee after go-live. It covers threshold tuning, model updates when cameras change position or lighting conditions shift seasonally, and a response SLA for incidents. Most sites run on a flat monthly fee.",
  },
];
---

<Layout title="Deployment">
  <Container>
    <div class="max-w-2xl mx-auto py-20">

      <!-- Heading -->
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">Deployment</h1>
      <p class="text-lg text-slate-600 mb-12">
        Every Atriva solution runs on the same stack. If a site has cameras and power, it's deployable.
      </p>

      <!-- Topology diagram -->
      <div class="mb-12">
        <svg
          viewBox="0 0 580 220"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full text-slate-700"
          aria-label="Deployment topology: IP cameras and the Atriva edge device stay on site; structured events go to your systems or the Atriva dashboard"
          role="img"
        >
          <!-- On-site dashed boundary -->
          <rect x="8" y="30" width="310" height="166" rx="10"
            fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-dasharray="6 4" opacity="0.3"/>
          <text x="16" y="24" font-size="9" fill="currentColor" opacity="0.45"
            font-family="system-ui, sans-serif" font-weight="600" letter-spacing="0.08em">
            STAYS ON SITE — NO VIDEO LEAVES THE NETWORK
          </text>

          <!--
            Camera icon reused twice via <use>.
            Shape: body rect + lens circle + rear mount nub.
            Defined at origin; positioned with transform on each <use>.
          -->
          <defs>
            <g id="cam">
              <!-- rear mount -->
              <rect x="-10" y="8" width="10" height="12" rx="2"
                fill="none" stroke="currentColor" stroke-width="1.5"/>
              <!-- body -->
              <rect x="0" y="0" width="44" height="28" rx="4"
                fill="none" stroke="currentColor" stroke-width="1.5"/>
              <!-- lens ring -->
              <circle cx="30" cy="14" r="9"
                fill="none" stroke="currentColor" stroke-width="1.5"/>
              <!-- lens inner dot -->
              <circle cx="30" cy="14" r="3"
                fill="currentColor" opacity="0.4"/>
            </g>
          </defs>

          <!-- Camera 1 -->
          <use href="#cam" transform="translate(34,68)" opacity="0.7"/>
          <text x="57" y="108" text-anchor="middle" font-size="9"
            fill="currentColor" opacity="0.6" font-family="system-ui, sans-serif">IP Camera</text>
          <text x="57" y="119" text-anchor="middle" font-size="8"
            fill="currentColor" opacity="0.4" font-family="system-ui, sans-serif">RTSP / ONVIF</text>

          <!-- Camera 2 (identical, offset down) -->
          <use href="#cam" transform="translate(34,148)" opacity="0.35"/>
          <text x="57" y="190" text-anchor="middle" font-size="8"
            fill="currentColor" opacity="0.3" font-family="system-ui, sans-serif">+ more cameras</text>

          <!-- Arrows: cameras → edge device -->
          <line x1="78" y1="82" x2="168" y2="104"
            stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
          <polygon points="168,104 160,98 160,110"
            fill="currentColor" opacity="0.5"/>

          <line x1="78" y1="162" x2="168" y2="120"
            stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
          <polygon points="168,120 160,124 160,114"
            fill="currentColor" opacity="0.3"/>

          <!-- Edge device -->
          <rect x="172" y="68" width="130" height="84" rx="8"
            fill="none" stroke="#48A18D" stroke-width="2"/>
          <text x="237" y="97" text-anchor="middle" font-size="11" font-weight="700"
            fill="#48A18D" font-family="system-ui, sans-serif">Atriva</text>
          <text x="237" y="112" text-anchor="middle" font-size="10"
            fill="#48A18D" font-family="system-ui, sans-serif">Edge Device</text>
          <text x="237" y="128" text-anchor="middle" font-size="8"
            fill="currentColor" opacity="0.45" font-family="system-ui, sans-serif">on-prem · runs inference</text>

          <!-- Arrows: edge device → outputs -->
          <line x1="302" y1="96" x2="352" y2="74"
            stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
          <polygon points="352,74 343,74 347,84"
            fill="currentColor" opacity="0.6"/>

          <line x1="302" y1="124" x2="352" y2="148"
            stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
          <polygon points="352,148 343,142 347,152"
            fill="currentColor" opacity="0.6"/>

          <!-- Output 1: Your systems -->
          <rect x="356" y="44" width="212" height="56" rx="8"
            fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55"/>
          <text x="462" y="68" text-anchor="middle" font-size="10" font-weight="600"
            fill="currentColor" font-family="system-ui, sans-serif">Your systems</text>
          <text x="462" y="84" text-anchor="middle" font-size="9"
            fill="currentColor" opacity="0.5" font-family="system-ui, sans-serif">JSON events · webhook / API</text>

          <!-- Output 2: Atriva dashboard -->
          <rect x="356" y="124" width="212" height="56" rx="8"
            fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55"/>
          <text x="462" y="148" text-anchor="middle" font-size="10" font-weight="600"
            fill="currentColor" font-family="system-ui, sans-serif">Atriva dashboard</text>
          <text x="462" y="164" text-anchor="middle" font-size="9"
            fill="currentColor" opacity="0.5" font-family="system-ui, sans-serif">live alerts · reports · history</text>
        </svg>
      </div>

      <!-- Spec table -->
      <dl class="divide-y divide-slate-200 border-y border-slate-200 mb-4">
        {specs.map(({ label, value }) => (
          <div class="grid grid-cols-5 gap-4 py-4">
            <dt class="col-span-2 text-sm font-semibold text-slate-500 uppercase tracking-wide self-center">
              {label}
            </dt>
            <dd class="col-span-3 text-sm text-slate-800">
              {value}
            </dd>
          </div>
        ))}
      </dl>

      <!-- Integration outputs — TODO: confirm which are supported -->
      <p class="text-xs text-slate-400 mb-12">
        Integration outputs: MQTT · Webhook · REST API
      </p>

      <!-- Stack note -->
      <p class="text-slate-600 leading-relaxed mb-12">
        Deployed as containers. The same image runs across every supported accelerator — the runtime is selected at install, so switching hardware doesn't mean rebuilding the application.
      </p>

      <!-- FAQ -->
      <div class="mb-12">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Common questions</h2>
        <dl class="divide-y divide-slate-200 border-y border-slate-200">
          {faqs.map(({ q, a }) => (
            <div class="py-5">
              <dt class="text-sm font-semibold text-slate-900 mb-2">{q}</dt>
              <dd class="text-sm text-slate-600 leading-relaxed">{a}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- CTA -->
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 text-white bg-[#48A18D] hover:bg-[#3b8675] font-semibold rounded-lg transition-colors shadow-lg shadow-[#48A18D]/25"
      >
        <Icon name="bx:bx-message-rounded-dots" class="w-5 h-5" />
        Talk to us about your site
      </a>

    </div>
  </Container>
</Layout>
