---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import ProductCard from "@/components/products/ProductCard.astro";
import ProductModal from "@/components/products/ProductModal.astro";
import { products } from "@/config/products";
import { Icon } from "astro-icon/components";

const solutionIds = [
  "retail-analytics",
  "safety-monitor",
  "smart-parking",
  "ai-vision-fall-detection",
  "meal-inspection-system",
  "ai-vision-agent",
];

const solutions = solutionIds
  .map(id => products.find(p => p.id === id))
  .filter(Boolean);

const featured = solutions.find(p => p.featured);
const rest = solutions.filter(p => !p.featured);
---

<Layout title="Solutions">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-tl from-[#48A18D]/15 via-[#48A18D]/5 to-transparent"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[#48A18D]/10 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>

    <Container>
      <div class="relative pt-20 pb-16 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#48A18D]/10 text-[#48A18D] text-sm font-medium mb-6">
          <Icon name="bx:bx-cube" class="w-4 h-4" />
          Deployment Experience
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 tracking-tight">
          Edge AI Solutions
        </h1>

        <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto mb-10">
          Solutions we've built, deployed, or developed with partners. Tell us what you need and we'll tell you what fits.
        </p>

        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-white bg-[#48A18D] hover:bg-[#3b8675] font-semibold rounded-lg transition-colors shadow-lg shadow-[#48A18D]/25"
        >
          <Icon name="bx:bx-message-rounded-dots" class="w-5 h-5" />
          Talk to Us
        </a>
      </div>
    </Container>
  </section>

  <!-- Tier 1: Featured solution -->
  {featured && (
    <section class="py-12">
      <Container>
        <div class="max-w-6xl mx-auto rounded-2xl border border-[#48A18D]/30 bg-white shadow-sm overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <!-- Left: headline + description + features -->
            <div class="p-8 md:p-10">
              <div class="flex gap-2 mb-4">
                {featured.useCaseIcons.map((icon) => (
                  <div class="w-10 h-10 rounded-lg bg-[#48A18D]/10 flex items-center justify-center">
                    <Icon name={icon} class="w-5 h-5 text-[#48A18D]" />
                  </div>
                ))}
              </div>
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">{featured.name}</h2>
              <p class="text-[#48A18D] font-medium mb-4">{featured.tagline}</p>
              <p class="text-slate-600 leading-relaxed mb-6">{featured.description}</p>
              <ul class="space-y-2 mb-8">
                {featured.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <Icon name="bx:bx-check" class="w-4 h-4 text-[#48A18D] flex-shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-col sm:flex-row gap-3">
                <button
                  type="button"
                  class="product-details-btn flex-1 px-5 py-2.5 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center justify-center gap-1.5"
                  data-product-id={featured.id}
                >
                  <Icon name="bx:bx-show" class="w-4 h-4" />
                  View Details
                </button>
                <a
                  href="/contact"
                  class="flex-1 px-5 py-2.5 text-sm font-medium rounded-lg transition-colors flex items-center justify-center gap-1.5 text-white bg-[#48A18D] hover:bg-[#3b8675]"
                >
                  <Icon name="bx:bx-message-rounded-dots" class="w-4 h-4" />
                  Talk to Us
                </a>
              </div>
            </div>
            <!-- Right: capabilities + applied to -->
            <div class="p-8 md:p-10 bg-slate-50 border-t md:border-t-0 md:border-l border-slate-200">
              <h3 class="text-xs font-semibold text-slate-900 uppercase tracking-widest mb-4">Key Capabilities</h3>
              <ul class="space-y-2 mb-8">
                {featured.capabilities.map((cap) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <Icon name="bx:bx-check-circle" class="w-4 h-4 text-[#48A18D] flex-shrink-0 mt-0.5" />
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
              {featured.appliedTo && (
                <>
                  <h3 class="text-xs font-semibold text-slate-900 uppercase tracking-widest mb-3">Applied To</h3>
                  <div class="flex flex-wrap gap-2">
                    {featured.appliedTo.map((tag) => (
                      <span class="px-3 py-1 text-xs font-medium bg-white text-slate-700 rounded-full border border-slate-200">
                        {tag}
                      </span>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- Tier 2: Remaining solutions -->
  <section class="py-12 pb-20">
    <Container>
      <div class="max-w-6xl mx-auto">
        <h2 class="text-xl font-semibold text-slate-700 mb-8">Same pipeline, different model and placement.</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map((solution) => (
            <ProductCard product={solution} />
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 bg-slate-50">
    <Container>
      <div class="relative rounded-3xl bg-gradient-to-br from-[#48A18D] to-[#3b8675] p-12 md:p-16 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
          <div class="absolute bottom-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2"></div>
        </div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Don't see exactly what you need?
          </h2>
          <p class="text-white/80 max-w-xl mx-auto mb-8">
            Most deployments are adapted to the customer's environment. Tell us the business problem and we'll work out the right approach together.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-[#48A18D] font-semibold rounded-lg hover:bg-slate-50 transition-colors"
          >
            <Icon name="bx:bx-message-rounded-dots" class="w-5 h-5" />
            Start a Conversation
          </a>
        </div>
      </div>
    </Container>
  </section>

  <ProductModal products={products} />
</Layout>
